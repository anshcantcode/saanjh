# Copy this file to backend/.env. Never put these server secrets in a browser or mobile bundle.

# SQLite file, relative to this backend directory unless an absolute path is used.
DATABASE_PATH=./saanjh.db

# Comma-separated origins. "*" is convenient for local development; restrict it in production.
CORS_ORIGINS=*

# Server-side Groq configuration.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_HISTORY_LIMIT=40

# Voicebox server configuration. The normal desktop port is 17493.
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_ENGINE=chatterbox_turbo
# First synthesis may need to load a multi-gigabyte model into GPU memory.
VOICEBOX_TIMEOUT_SECONDS=300
VOICEBOX_MAX_UPLOAD_MB=50
VOICEBOX_MAX_AUDIO_MB=100
