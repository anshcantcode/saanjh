  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "npm --prefix web run dev",
    "dev": "npm --prefix web run dev",
    "web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "api": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "typecheck:web": "npm --prefix web run build",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "android:local": "expo run:android",
    "android:build:preview": "npx eas-cli build --platform android --profile preview",
    "android:build:production": "npx eas-cli build --platform android --profile production",
    "expo:ios": "expo start --ios",
    "expo:web": "expo start --web",
    "typecheck:expo": "tsc --noEmit",
    "doctor:expo": "expo-doctor",
    "config:expo": "expo config --type public"
  },
