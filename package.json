{
  "name": "saanjh-expo",
  "version": "1.0.0",
  "description": "Consent-first, local-first AI voice companion built with Expo and FastAPI.",
  "private": true,
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm --prefix web run dev",
    "dev": "npm --prefix web run dev",
    "web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "api": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "api:lan": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000",
    "api:tunnel:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\start-quick-tunnel.ps1",
    "api:copy-key": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\copy-mobile-key.ps1",
    "api:service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\windows\\install-saanjh-server.ps1",
    "api:service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\windows\\start-saanjh-server.ps1",
    "api:service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\windows\\status-saanjh-server.ps1",
    "api:service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\windows\\stop-saanjh-server.ps1",
    "api:service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\windows\\uninstall-saanjh-server.ps1",
    "voicebox:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy\\windows\\install-voicebox-autostart.ps1",
    "typecheck:web": "npm --prefix web run build",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "android:local": "expo run:android",
    "android:build:preview": "npx eas-cli build --platform android --profile preview",
    "android:build:production": "npx eas-cli build --platform android --profile production",
    "expo:ios": "expo start --ios",
    "expo:web": "expo start --web",
    "typecheck:expo": "tsc --noEmit",
    "test:backend": "python backend/run_tests.py",
    "showcase": "npm --prefix showcase run dev",
    "showcase:build": "npm --prefix showcase run build",
    "check": "npm run typecheck:expo && npm run build && npm run showcase:build && npm run test:backend",
    "doctor:expo": "expo-doctor",
    "config:expo": "expo config --type public"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.4",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.17.11",
    "typescript": "~6.0.3"
  }
}
