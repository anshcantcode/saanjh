# Optional public, non-secret default for the deployed Saanjh FastAPI gateway.
# Leave blank when the address will be entered and tested inside the app.
EXPO_PUBLIC_API_URL=

# EAS project ID for this fork. Find it in the Expo dashboard or after `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional private-demo bootstrap credential. This is compiled into the APK and
# is therefore recoverable. Keep it only in an ignored .env or an EAS secret;
# never commit it, and do not use this shared-token pattern for public releases.
SAANJH_API_ACCESS_TOKEN=

# Local Android HTTP development only. Production and tunnel builds should use
# HTTPS and leave this false/blank.
EXPO_PUBLIC_ALLOW_CLEARTEXT=
